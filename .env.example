# Copy to .env and fill in. Both keys are optional: Portia on Muse Glimmer alone (self-hosted, Modal or Fireworks) needs neither.
# Never commit .env.

# Muse Spark 1.3 on the Meta Model API (https://dev.meta.ai): the "Spark 1.3 checks every verdict" mode
META_MODEL_API_KEY=
# the model to call (default: muse-spark-1.3-contributor) and a spend cap in USD for this key
PORTIA_SPARK13_MODEL=muse-spark-1.3-contributor
PORTIA_META_CAP_USD=4.0

# Muse Spark Open on Baseten (model meta-models/muse-spark-open-1026): the Spark Open adjudicator for splits
BASETEN_API_KEY=

# Where the pre-existing data lives (or set them in paths.local.json; see judge/paths.py)
# PORTIA_DATASET=/path/to/final_all.jsonl
# PORTIA_VIDEOS=/path/to/videos_list
# PORTIA_INDEX=/path/to/Qwen--Qwen3-VL-Embedding-8B
# PORTIA_SHARDS=/path/to/final_all_shards

# Public mode: anything that starts work needs this code in an X-Portia-Code header (leave empty for local use)
# PORTIA_ACCESS_CODE=
